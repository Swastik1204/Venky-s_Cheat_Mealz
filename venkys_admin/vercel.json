{
  "version": 2,
  "framework": null,
  "ignoreCommand": "git diff --quiet HEAD^ HEAD ./ || exit 1",
  "buildCommand": "echo 'Vercel API only, frontend served by Firebase Hosting'",
  "outputDirectory": "public-empty",
  "headers": [
    {
      "source": "/api/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Access-Control-Max-Age", "value": "86400" }
      ]
    }
  ],
  "rewrites": [
    { "source": "/api/notify-order", "destination": "/api/notify?__route=order" },
    { "source": "/api/notify-status", "destination": "/api/notify?__route=status" },
    { "source": "/api/cleanup-logs-scan", "destination": "/api/cleanup-logs?__route=scan" },
    { "source": "/api/cleanup-logs-delete", "destination": "/api/cleanup-logs?__route=delete" },
    { "source": "/api/health", "destination": "/api/meta?__route=health" },
    { "source": "/api/public-config", "destination": "/api/meta?__route=config" }
  ],
  "crons": [
    {
      "path": "/api/cleanup-logs?__route=scan",
      "schedule": "0 3 * * 0"
    }
  ]
}
