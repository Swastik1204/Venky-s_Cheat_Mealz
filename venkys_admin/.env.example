# Frontend Firebase API key used by Vite client build.
VITE_FIREBASE_API_KEY=your_firebase_api_key
# Frontend Firebase auth domain used by Vite client build.
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
# Frontend Firebase project ID used by Vite client build.
VITE_FIREBASE_PROJECT_ID=your-project-id
# Frontend Firebase storage bucket used by Vite client build.
VITE_FIREBASE_STORAGE_BUCKET=your-project.appspot.com
# Frontend Firebase messaging sender ID used by Vite client build.
VITE_FIREBASE_MESSAGING_SENDER_ID=1234567890
# Frontend Firebase app ID used by Vite client build.
VITE_FIREBASE_APP_ID=1:1234567890:web:abcdef123456
# Razorpay public key used by admin checkout.
VITE_RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxx
# Optional frontend API base override.
VITE_API_BASE_URL=
# Optional Vercel host fallback used by frontend API helper.
VITE_VERCEL_URL=

# Razorpay key ID used by serverless order/payment endpoints.
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxx
# Razorpay key secret used by serverless order/payment endpoints.
RAZORPAY_KEY_SECRET=your_razorpay_key_secret

# Required: paste entire Firebase service account JSON as a single line. Get from Firebase Console -> Project Settings -> Service Accounts -> Generate new private key
FIREBASE_SERVICE_ACCOUNT={"type":"service_account","project_id":"your-project-id"}
# Set to 0/false to disable Firebase token checks in serverless auth guard.
AUTH_REQUIRED=true

# Allowed CORS origin(s) for API routes (comma-separated).
CORS_ORIGIN=https://your-admin-domain.com

# SMTP username used by server log-email endpoint.
EMAIL_USER=alerts@example.com
# SMTP password/app password used by server log-email endpoint.
EMAIL_PASS=your_email_app_password
# Recipient email for log-email alerts.
LOG_EMAIL_RECIPIENT=owner@example.com

# Shared internal secret for privileged internal API calls.
API_INTERNAL_SECRET=your_internal_api_secret
# Upstash Redis REST URL used by API rate limiter.
UPSTASH_REDIS_REST_URL=https://your-upstash-url.upstash.io
# Upstash Redis REST token used by API rate limiter.
UPSTASH_REDIS_REST_TOKEN=your_upstash_token
# Optional Vercel deployment host used by internal email notifications.
VERCEL_URL=
# Set true/1 to disable API rate limiting globally.
RATE_LIMIT_DISABLED=false
# Set true/1 to enable API kill switch responses.
API_KILL_SWITCH=false
# Kill-switch response reason returned when API kill switch is enabled.
API_KILL_SWITCH_REASON=API temporarily disabled for maintenance
# Set true/1 to log rate limiter events in production.
LOG_RATE_LIMITS=false

# ── FCM Push Notifications ─────────────────────────────────────────────────
# Firebase Cloud Messaging legacy server key (used by create-order.js)
# Get from: Firebase Console → Project Settings → Cloud Messaging → Server key
FCM_SERVER_KEY=firebase-cloud-messaging-legacy-server-key-here

# ── WhatsApp ──────────────────────────────────────────────────────
# STATUS: All WhatsApp features currently DISABLED
# Active env vars below are kept for when display name gets approved
# Re-enable: uncomment function bodies in data-whatsapp.js
WA_TOKEN=
WA_PHONE_NUMBER_ID=
WA_TEMPLATE_DEFAULT_NAME=hello_world
WA_TEMPLATE_DEFAULT_LANG=en_US
WA_BUSINESS_ACCOUNT_ID=
WA_API_VERSION=v21.0
