  "log_alert.roles_create_changed": {
    "subject": "🔔 New staff member added — [CREATE] Staff member added <b>x</b>",
    "html": "<div style=\"font-family: -apple-system, Segoe UI, Roboto, Arial, sans-serif; color: #1f2937; max-width: 560px;\">\n  <h2 style=\"margin: 0 0 4px;\">New staff member added</h2>\n  <p style=\"color: #6b7280; margin: 0 0 20px; font-size: 13px;\">21 Sept 2026, 7:00 pm IST</p>\n\n  <table style=\"width: 100%; border-collapse: collapse; margin-bottom: 16px;\">\n    <tr>\n      <td style=\"padding: 4px 0; color: #6b7280; width: 90px; vertical-align: top;\">What</td>\n      <td style=\"padding: 4px 0;\">[CREATE] Staff member added &lt;b&gt;x&lt;/b&gt;</td>\n    </tr>\n    <tr>\n      <td style=\"padding: 4px 0; color: #6b7280; vertical-align: top;\">Who</td>\n      <td style=\"padding: 4px 0;\">owner@x.com</td>\n    </tr>\n  </table>\n\n  <p style=\"margin: 0 0 4px;\"><strong>What changed</strong></p><ul style=\"margin: 8px 0 0; padding-left: 20px;\"><li><strong>Role:</strong> (empty) &rarr; staff</li><li><strong>Page Access:</strong> {&quot;a&quot;:1} &rarr; (empty)</li></ul><div style=\"margin-bottom: 16px;\"></div>\n\n  <p style=\"background: #fffbeb; border-left: 3px solid #f59e0b; padding: 10px 14px; margin: 0 0 20px; font-size: 14px;\">\n    <strong>Why it matters:</strong> This person can now sign in to the admin panel with whatever access they were given.\n  </p>\n\n  <hr style=\"border: none; border-top: 1px solid #e5e7eb; margin: 24px 0;\" />\n\n  <details>\n    <summary style=\"cursor: pointer; color: #6b7280; font-size: 12px;\">Technical details (for developer use)</summary>\n    <div style=\"background: #f9fafb; border: 1px solid #e5e7eb; border-radius: 6px; padding: 12px; margin-top: 8px; font-size: 12px; color: #374151;\">\n      <p style=\"margin: 0 0 6px;\"><strong>type:</strong> roles_create</p>\n      <pre style=\"white-space: pre-wrap; word-break: break-word; margin: 0;\">{\n  &quot;documentId&quot;: &quot;a@b.com&quot;,\n  &quot;performedBy&quot;: &quot;owner@x.com&quot;,\n  &quot;changedFields&quot;: {\n    &quot;role&quot;: {\n      &quot;from&quot;: null,\n      &quot;to&quot;: &quot;staff&quot;\n    },\n    &quot;pageAccess&quot;: {\n      &quot;from&quot;: {\n        &quot;a&quot;: 1\n      },\n      &quot;to&quot;: &quot;&quot;\n    }\n  }\n}</pre>\n    </div>\n  </details>\n\n  <p style=\"color: #9ca3af; font-size: 11px; margin-top: 24px;\">Sent from Venky's Cheat Mealz monitoring system</p>\n</div>"
  },
  "log_alert.roles_update": {
    "subject": "🔔 Staff permissions changed — [UPDATE] Staff member updated",
    "html": "<div style=\"font-family: -apple-system, Segoe UI, Roboto, Arial, sans-serif; color: #1f2937; max-width: 560px;\">\n  <h2 style=\"margin: 0 0 4px;\">Staff permissions changed</h2>\n  <p style=\"color: #6b7280; margin: 0 0 20px; font-size: 13px;\">21 Sept 2026, 7:00 pm IST</p>\n\n  <table style=\"width: 100%; border-collapse: collapse; margin-bottom: 16px;\">\n    <tr>\n      <td style=\"padding: 4px 0; color: #6b7280; width: 90px; vertical-align: top;\">What</td>\n      <td style=\"padding: 4px 0;\">[UPDATE] Staff member updated</td>\n    </tr>\n    <tr>\n      <td style=\"padding: 4px 0; color: #6b7280; vertical-align: top;\">Who</td>\n      <td style=\"padding: 4px 0;\">owner@x.com</td>\n    </tr>\n  </table>\n\n  <p style=\"margin: 0 0 4px;\"><strong>What changed</strong></p><ul style=\"margin: 8px 0 0; padding-left: 20px;\"><li><strong>Role:</strong> staff &rarr; admin</li></ul><div style=\"margin-bottom: 16px;\"></div>\n\n  <p style=\"background: #fffbeb; border-left: 3px solid #f59e0b; padding: 10px 14px; margin: 0 0 20px; font-size: 14px;\">\n    <strong>Why it matters:</strong> Someone's access to admin pages was changed. Worth a glance if you didn't make this change yourself.\n  </p>\n\n  <hr style=\"border: none; border-top: 1px solid #e5e7eb; margin: 24px 0;\" />\n\n  <details>\n    <summary style=\"cursor: pointer; color: #6b7280; font-size: 12px;\">Technical details (for developer use)</summary>\n    <div style=\"background: #f9fafb; border: 1px solid #e5e7eb; border-radius: 6px; padding: 12px; margin-top: 8px; font-size: 12px; color: #374151;\">\n      <p style=\"margin: 0 0 6px;\"><strong>type:</strong> roles_update</p>\n      <pre style=\"white-space: pre-wrap; word-break: break-word; margin: 0;\">{\n  &quot;performedBy&quot;: &quot;owner@x.com&quot;,\n  &quot;changedFields&quot;: {\n    &quot;role&quot;: {\n      &quot;from&quot;: &quot;staff&quot;,\n      &quot;to&quot;: &quot;admin&quot;\n    }\n  }\n}</pre>\n    </div>\n  </details>\n\n  <p style=\"color: #9ca3af; font-size: 11px; margin-top: 24px;\">Sent from Venky's Cheat Mealz monitoring system</p>\n</div>"
  },
  "log_alert.stock_low": {
    "subject": "🔔 Stock running low — Cheese is below 2 kg",
    "html": "<div style=\"font-family: -apple-system, Segoe UI, Roboto, Arial, sans-serif; color: #1f2937; max-width: 560px;\">\n  <h2 style=\"margin: 0 0 4px;\">Stock running low</h2>\n  <p style=\"color: #6b7280; margin: 0 0 20px; font-size: 13px;\">21 Sept 2026, 7:00 pm IST</p>\n\n  <table style=\"width: 100%; border-collapse: collapse; margin-bottom: 16px;\">\n    <tr>\n      <td style=\"padding: 4px 0; color: #6b7280; width: 90px; vertical-align: top;\">What</td>\n      <td style=\"padding: 4px 0;\">Cheese is below 2 kg</td>\n    </tr>\n    <tr>\n      <td style=\"padding: 4px 0; color: #6b7280; vertical-align: top;\">Who</td>\n      <td style=\"padding: 4px 0;\">the system</td>\n    </tr>\n  </table>\n\n  \n\n  <p style=\"background: #fffbeb; border-left: 3px solid #f59e0b; padding: 10px 14px; margin: 0 0 20px; font-size: 14px;\">\n    <strong>Why it matters:</strong> An ingredient is close to running out — you may want to reorder soon.\n  </p>\n\n  <hr style=\"border: none; border-top: 1px solid #e5e7eb; margin: 24px 0;\" />\n\n  <details>\n    <summary style=\"cursor: pointer; color: #6b7280; font-size: 12px;\">Technical details (for developer use)</summary>\n    <div style=\"background: #f9fafb; border: 1px solid #e5e7eb; border-radius: 6px; padding: 12px; margin-top: 8px; font-size: 12px; color: #374151;\">\n      <p style=\"margin: 0 0 6px;\"><strong>type:</strong> stock_low_alert</p>\n      <pre style=\"white-space: pre-wrap; word-break: break-word; margin: 0;\">{\n  &quot;item&quot;: &quot;cheese&quot;,\n  &quot;qty&quot;: 1.5\n}</pre>\n    </div>\n  </details>\n\n  <p style=\"color: #9ca3af; font-size: 11px; margin-top: 24px;\">Sent from Venky's Cheat Mealz monitoring system</p>\n</div>"
  },
  "log_alert.rate_limit": {
    "subject": "🔔 Unusual amount of traffic — Rate limit exceeded for place-order",
    "html": "<div style=\"font-family: -apple-system, Segoe UI, Roboto, Arial, sans-serif; color: #1f2937; max-width: 560px;\">\n  <h2 style=\"margin: 0 0 4px;\">Unusual amount of traffic</h2>\n  <p style=\"color: #6b7280; margin: 0 0 20px; font-size: 13px;\">21 Sept 2026, 7:00 pm IST</p>\n\n  <table style=\"width: 100%; border-collapse: collapse; margin-bottom: 16px;\">\n    <tr>\n      <td style=\"padding: 4px 0; color: #6b7280; width: 90px; vertical-align: top;\">What</td>\n      <td style=\"padding: 4px 0;\">Rate limit exceeded for place-order</td>\n    </tr>\n    <tr>\n      <td style=\"padding: 4px 0; color: #6b7280; vertical-align: top;\">Who</td>\n      <td style=\"padding: 4px 0;\">the system</td>\n    </tr>\n  </table>\n\n  \n\n  <p style=\"background: #fffbeb; border-left: 3px solid #f59e0b; padding: 10px 14px; margin: 0 0 20px; font-size: 14px;\">\n    <strong>Why it matters:</strong> Someone (or something) is hitting the ordering system faster than normal. Usually harmless — but if you keep getting this, it could be a bot or someone testing the app.\n  </p>\n\n  <hr style=\"border: none; border-top: 1px solid #e5e7eb; margin: 24px 0;\" />\n\n  <details>\n    <summary style=\"cursor: pointer; color: #6b7280; font-size: 12px;\">Technical details (for developer use)</summary>\n    <div style=\"background: #f9fafb; border: 1px solid #e5e7eb; border-radius: 6px; padding: 12px; margin-top: 8px; font-size: 12px; color: #374151;\">\n      <p style=\"margin: 0 0 6px;\"><strong>type:</strong> rate_limit_violation</p>\n      <pre style=\"white-space: pre-wrap; word-break: break-word; margin: 0;\">{\n  &quot;clientId&quot;: &quot;ip:1.2.3.4&quot;,\n  &quot;routeName&quot;: &quot;place-order&quot;,\n  &quot;reason&quot;: &quot;burst&quot;,\n  &quot;timestamp&quot;: &quot;2026-09-21T13:30:00.000Z&quot;\n}</pre>\n    </div>\n  </details>\n\n  <p style=\"color: #9ca3af; font-size: 11px; margin-top: 24px;\">Sent from Venky's Cheat Mealz monitoring system</p>\n</div>"
  },
  "log_alert.unknown_no_meta": {
    "subject": "🔔 System alert — Hello & \"quotes\"",
    "html": "<div style=\"font-family: -apple-system, Segoe UI, Roboto, Arial, sans-serif; color: #1f2937; max-width: 560px;\">\n  <h2 style=\"margin: 0 0 4px;\">System alert</h2>\n  <p style=\"color: #6b7280; margin: 0 0 20px; font-size: 13px;\">21 Sept 2026, 7:00 pm IST</p>\n\n  <table style=\"width: 100%; border-collapse: collapse; margin-bottom: 16px;\">\n    <tr>\n      <td style=\"padding: 4px 0; color: #6b7280; width: 90px; vertical-align: top;\">What</td>\n      <td style=\"padding: 4px 0;\">Hello &amp; &quot;quotes&quot;</td>\n    </tr>\n    <tr>\n      <td style=\"padding: 4px 0; color: #6b7280; vertical-align: top;\">Who</td>\n      <td style=\"padding: 4px 0;\">the system</td>\n    </tr>\n  </table>\n\n  \n\n  <p style=\"background: #fffbeb; border-left: 3px solid #f59e0b; padding: 10px 14px; margin: 0 0 20px; font-size: 14px;\">\n    <strong>Why it matters:</strong> Something happened that the system thought you should know about.\n  </p>\n\n  <hr style=\"border: none; border-top: 1px solid #e5e7eb; margin: 24px 0;\" />\n\n  <details>\n    <summary style=\"cursor: pointer; color: #6b7280; font-size: 12px;\">Technical details (for developer use)</summary>\n    <div style=\"background: #f9fafb; border: 1px solid #e5e7eb; border-radius: 6px; padding: 12px; margin-top: 8px; font-size: 12px; color: #374151;\">\n      <p style=\"margin: 0 0 6px;\"><strong>type:</strong> something_new</p>\n      <p style=\"margin:0; color:#9ca3af;\">(no metadata)</p>\n    </div>\n  </details>\n\n  <p style=\"color: #9ca3af; font-size: 11px; margin-top: 24px;\">Sent from Venky's Cheat Mealz monitoring system</p>\n</div>"
  },
  "log_cleanup_review": {
    "subject": "🔔 42 old logs are ready for cleanup",
    "html": "<div style=\"font-family: -apple-system, Segoe UI, Roboto, Arial, sans-serif; color: #1f2937; max-width: 560px;\">\n  <h2 style=\"margin: 0 0 4px;\">42 old logs are ready for cleanup</h2>\n  <p style=\"color: #6b7280; margin: 0 0 20px; font-size: 13px;\">Weekly audit log review</p>\n\n  <table style=\"width: 100%; border-collapse: collapse; margin-bottom: 20px;\">\n    <tr>\n      <td style=\"padding: 4px 0; color: #6b7280; width: 90px; vertical-align: top;\">What</td>\n      <td style=\"padding: 4px 0;\">42 audit log entries are older than 2 months and are candidates for deletion. Oldest entry: 1 Jul 2026, 9:00 am.</td>\n    </tr>\n  </table>\n\n  <div style=\"margin: 24px 0;\">\n    <a href=\"https://venkys-admin.web.app/admin/log-cleanup?token=abc\" style=\"display: inline-block; background: #f59e0b; color: #1f2937; padding: 12px 28px; border-radius: 8px; text-decoration: none; font-weight: 700; font-size: 15px;\">\n      Review &amp; decide\n    </a>\n  </div>\n\n  <p style=\"background: #fffbeb; border-left: 3px solid #f59e0b; padding: 10px 14px; margin: 0 0 20px; font-size: 14px;\">\n    <strong>Why it matters:</strong> Nothing is deleted automatically. Every entry is pre-selected on the review page, but you choose exactly what stays or goes before anything is removed.\n  </p>\n\n  <hr style=\"border: none; border-top: 1px solid #e5e7eb; margin: 24px 0;\" />\n  <p style=\"color: #9ca3af; font-size: 11px;\">Sent from Venky's Cheat Mealz log maintenance</p>\n</div>"
  },
  "staff_invite": {
    "subject": "You're invited to join Venky's staff",
    "html": "<div style=\"font-family: -apple-system, Segoe UI, Roboto, Arial, sans-serif; color: #1f2937; max-width: 560px;\">\n  <h2 style=\"margin: 0 0 4px;\">You're invited to join Venky's staff</h2>\n  <p style=\"color: #6b7280; margin: 0 0 20px; font-size: 13px;\">Sent by Owner &lt;O&gt;</p>\n\n  <table style=\"width: 100%; border-collapse: collapse; margin-bottom: 20px;\">\n    <tr>\n      <td style=\"padding: 4px 0; color: #6b7280; width: 90px; vertical-align: top;\">What</td>\n      <td style=\"padding: 4px 0;\">Owner &lt;O&gt; added you to the Venky's admin panel as <strong>staff</strong>.</td>\n    </tr>\n    <tr>\n      <td style=\"padding: 4px 0; color: #6b7280; vertical-align: top;\">Expires</td>\n      <td style=\"padding: 4px 0;\">23 Sept 2026, 7:00 pm IST — after that you'll need a fresh invite.</td>\n    </tr>\n  </table>\n\n  <div style=\"margin: 24px 0;\">\n    <a href=\"https://venkys-admin.web.app/claim?token=xyz\" style=\"display: inline-block; background: #f59e0b; color: #1f2937; padding: 12px 28px; border-radius: 8px; text-decoration: none; font-weight: 700; font-size: 15px;\">\n      Activate my access\n    </a>\n  </div>\n\n  <p style=\"background: #fffbeb; border-left: 3px solid #f59e0b; padding: 10px 14px; margin: 0 0 20px; font-size: 14px;\">\n    <strong>Why it matters:</strong> This link only works when you sign in with the email address it was sent to. If you weren't expecting this, you can safely ignore it — nothing happens until the link is opened and confirmed.\n  </p>\n\n  <hr style=\"border: none; border-top: 1px solid #e5e7eb; margin: 24px 0;\" />\n  <p style=\"color: #9ca3af; font-size: 11px;\">Sent from Venky's Cheat Mealz staff onboarding</p>\n</div>"
