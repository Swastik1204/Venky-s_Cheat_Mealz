rules_version = '2';

// =====================================================================
// UNIFIED FIRESTORE RULES - Venky's Chicken Xperience
// =====================================================================
// This single rules file is used by BOTH customer app and admin app.
//
// ROLE HIERARCHY:
//   1. Super Admin (hardcoded) - swastiksaha1204@gmail.com - ALWAYS has full access
//   2. Admin (dynamic) - role: 'admin' in roles collection - Full access
//   3. Staff (dynamic) - role: 'staff' with page-specific permissions
//   4. Delivery (dynamic) - role: 'delivery' - Can view/update assigned deliveries
//   5. Customer - Regular signed-in users - Can manage own profile & orders
//   6. Guest - Unauthenticated - Can read public data only
//
// ROLE DOCUMENT STRUCTURE (roles/{email}):
//   {
//     role: 'admin' | 'staff' | 'delivery',
//     name: 'Display Name',
//     email: 'user@example.com',
//     pages: {
//       biller: true/false,      // POS billing
//       orders: true/false,      // Order management
//       inventory: true/false,   // Menu & stock management
//       analytics: true/false,   // Sales analytics
//       settings: true/false,    // App settings (admin only typically)
//       appearance: true/false,  // Theme customization
//       delivery: true/false,    // Delivery management
//       cashManager: true/false, // Dine-in COD OTP generation
//       orderMessenger: true/false, // (legacy — WhatsApp order alerts, unused)
//     },
//     createdAt: timestamp,
//     updatedAt: timestamp,
//     createdBy: 'admin@email.com'
//   }
//
// `roles/{email}` is the single source of truth for staff/admin access.
// The former `adminUsers/{uid}` collection (invite-based onboarding) has
// been retired: it was populated by nobody in production (verified against
// live data before removal) and every real staff/admin account already
// resolves through `roles`. There is no `adminUsers` match block below —
// the collection now falls through to the default-deny at the bottom of
// this file.
// =====================================================================

service cloud.firestore {
  match /databases/{database}/documents {

    // =========================================
    // HELPER FUNCTIONS
    // =========================================

    // Super admin email - HARDCODED, always has full access, carries zero
    // custom claims/role-doc dependency by design. This is the recovery
    // bypass if the roles collection is ever corrupted or misconfigured.
    function superAdminEmail() {
      return 'swastiksaha1204@gmail.com';
    }

    // Check if user is signed in
    function isSignedIn() {
      return request.auth != null;
    }

    // Email is required for role-based access (roles are keyed by email)
    function hasEmail() {
      return isSignedIn() && request.auth.token.email is string && request.auth.token.email.size() > 0;
    }

    // Check if current user is the super admin
    function isSuperAdmin() {
      return hasEmail() && request.auth.token.email == superAdminEmail();
    }

    // Get role document for current user
    function getRoleDoc() {
      return get(/databases/$(database)/documents/roles/$(request.auth.token.email)).data;
    }

    // Check if user has a role document
    function hasRoleDoc() {
      return hasEmail() && exists(/databases/$(database)/documents/roles/$(request.auth.token.email));
    }

    function hasStaffPage(pageName) {
      return isStaffUser()
        && getRoleDoc().pages != null
        && getRoleDoc().pages[pageName] == true;
    }

    // Role helpers
    function isStaffUser() {
      return hasRoleDoc() && getRoleDoc().role == 'staff';
    }

    function isDeliveryUser() {
      return hasRoleDoc() && getRoleDoc().role == 'delivery';
    }

    // Check if user is an admin (super admin OR role == 'admin')
    function isAdmin() {
      return isSuperAdmin() || (hasRoleDoc() && getRoleDoc().role == 'admin');
    }

    // canAccess(pageName): the single access-check pattern used everywhere
    // in this file. It is always OR logic — isAdmin() (which already
    // includes isSuperAdmin()) is checked first and short-circuits, so
    // admin/superadmin ALWAYS bypass granular per-page permissions. A plain
    // staff role only passes if it explicitly holds that page's permission.
    // Do not rewrite call sites as "isStaffUser() && canAccess(...)" — AND
    // logic here would incorrectly require admins to also hold a staff-style
    // page permission they were never given.
    function canAccess(pageName) {
      return isAdmin() || hasStaffPage(pageName);
    }

    function isCashManagerUser() {
      return canAccess('cashManager');
    }

    function isOrderMessengerUser() {
      return canAccess('orderMessenger');
    }

    // Check if user can manage orders (includes biller page access)
    function canManageOrders() {
      return canAccess('orders') || canAccess('biller') || isCashManagerUser();
    }

    // Read-only order access for sub-roles that should not mutate lifecycle.
    function canViewOrders() {
      return canManageOrders() || isOrderMessengerUser();
    }

    // Check if user can manage inventory
    function canManageInventory() {
      return canAccess('inventory');
    }

    // Check if user is any type of staff member
    function isStaff() {
      return hasRoleDoc();
    }

    function isDeliveryOrder(data) {
      return data != null && data.orderType == 'delivery';
    }

    // Delivery-role field restriction: this is a security boundary, not a
    // UI convenience, and stays separate from the general staff-update
    // allowlist below. A user holding ONLY the 'delivery' permission may
    // update a delivery order but ONLY these four fields — admin/superadmin
    // still bypass this restriction entirely via isAdmin() at the update
    // rule's top level, but a plain delivery-role user is field-locked
    // exactly as before, regardless of what other permissions get added to
    // canAccess() in the future.
    function deliveryCanUpdateOrder() {
      return isDeliveryUser()
        && isDeliveryOrder(resource.data)
        && request.resource.data.diff(resource.data).changedKeys().hasOnly([
          'status',
          'statusHistory',
          'updatedAt',
          'deliveredAt'
        ]);
    }

    // Append-only guard for statusHistory: a write may only grow the array,
    // never replace or shrink it. This blocks the cheap/common tampering
    // case (wiping the history, or swapping in a shorter fabricated one).
    //
    // LIMITATION: Firestore rules cannot cheaply inspect individual array
    // elements, so this check is size-based only. A write that keeps the
    // same array length but replaces one entry's content (e.g. rewriting an
    // existing entry's `status` or `at` value while adding no new entry)// is NOT caught by this rule. Closing that gap would require either a
    // security-rules unit-test suite asserting element-by-index equality
    // (expensive to maintain for a solo developer) or moving all status
    // writes through a server endpoint that owns statusHistory unilaterally
    // (not scoped for this pass). This function narrows the tampering
    // surface; it does not eliminate it.
    function historyNotShrunk() {
      return !('statusHistory' in request.resource.data.diff(resource.data).changedKeys())
        || request.resource.data.statusHistory.size() >= resource.data.statusHistory.size();
    }

    // (hasCanonicalOrderShape() was removed here: it validated client-submitted
    // order shape on create, but /orders create is now `allow create: if false`
    // — order documents are only ever written by the Admin SDK from
    // /api/place-order, which is trusted code, not a rules-validated client
    // write. The legacy /users/{uid}/orders/{orderId} create is also denied
    // for the same reason. See the ORDERS COLLECTION section below.)

    // =========================================
    // COLLECTION RULES
    // =========================================

    // -----------------------------------------
    // ROLES COLLECTION (Staff Management)
    // -----------------------------------------
    match /roles/{email} {
      // Users can read only their own role doc; admins can read any role doc.
      allow get: if isAdmin() || (isSignedIn() && request.auth.token.email == email);
      // Collection queries on roles are admin-only.
      allow list: if isAdmin();

      // Only super admin and admins can create/update/delete roles
      // Super admin can manage all roles, admins cannot modify super admin's role
      allow create: if isAdmin()
        && request.resource.data.role in ['admin', 'staff', 'delivery']
        && (!("nickname" in request.resource.data) || request.resource.data.nickname is string);
      allow update: if isAdmin()
        && (isSuperAdmin() || email != superAdminEmail())
        && request.resource.data.role in ['admin', 'staff', 'delivery']
        && (!("nickname" in request.resource.data) || request.resource.data.nickname is string);
      allow delete: if isAdmin() && email != superAdminEmail(); // Cannot delete super admin
    }

    // -----------------------------------------
    // USERS COLLECTION (Customer Profiles)
    // -----------------------------------------
    match /users/{uid} {
      // Users can read/write their own document
      // Admins can read/write all user documents
      // Billers can write to 'guest' user for POS orders
      allow read: if isAdmin() || (isSignedIn() && request.auth.uid == uid);
      allow create, update: if isAdmin() || (isSignedIn() && request.auth.uid == uid) || (canAccess('biller') && uid == 'guest');
      allow delete: if isAdmin() || ((isSignedIn() && request.auth.uid == uid) && !hasRoleDoc());

      // User's nested orders (legacy subcollection). No code path writes
      // here anymore — order creation is server-owned (see /orders below) —
      // so create is denied. get/list/update remain for any pre-existing
      // legacy documents that still need to be read or migrated.
      match /orders/{orderId} {
        allow create: if false;
        allow get: if isAdmin() || canManageOrders() || isDeliveryUser() || (isSignedIn() && request.auth.uid == uid);
        allow list: if isAdmin() || isStaff() || (isSignedIn() && request.auth.uid == uid);
        allow update: if isAdmin() || canManageOrders() || (isSignedIn() && request.auth.uid == uid);
        allow delete: if false; // Never delete orders
      }

      // All other user subcollections (cart, addresses, meta, etc.)
      match /{subcollection}/{docId} {
        allow read: if isAdmin() || (isSignedIn() && request.auth.uid == uid);
        allow create, update: if isAdmin() || (isSignedIn() && request.auth.uid == uid);
        allow delete: if isAdmin() || ((isSignedIn() && request.auth.uid == uid) && !hasRoleDoc());
      }
    }

    // -----------------------------------------
    // ORDERS COLLECTION (Main Orders)
    // -----------------------------------------
    match /orders/{orderId} {
      // CREATE: order documents are now created exclusively by the
      // /api/place-order server endpoint (Firebase Admin SDK, which bypasses
      // these rules entirely). No client — customer or staff — creates an
      // order document directly anymore: this closes the order-number
      // collision risk of the old client-side counter-transaction +
      // client setDoc() pattern, since the counter increment and the
      // document create now happen in one atomic server-side transaction
      // with a create-only (never-overwrite) guard. Direct client writes
      // are denied here so there is no stale permissive path left open
      // once the app code moved off it.
      allow create: if false;

      // READ (document): Staff can read any order, users can read own order.
      allow get: if isAdmin() || canViewOrders() || isDeliveryUser() ||
        (isSignedIn() && resource.data.userId == request.auth.uid);

      // READ (collection query): Staff can list all orders; customers can only list their own orders.
      allow list: if isAdmin() || canViewOrders() || isDeliveryUser() ||
        (isSignedIn() && resource.data.userId == request.auth.uid);

      // UPDATE: field-restricted per role. Admin/superadmin bypass every
      // allowlist below via the isAdmin() branch (canAccess()'s OR-logic
      // pattern) — a plain staff/delivery/cashManager role is confined to
      // exactly the fields listed for their case.
      allow update: if (
        isAdmin() ||
        deliveryCanUpdateOrder() ||
        (
          canManageOrders() && historyNotShrunk() && (
            // 1. Cash Manager generating/regenerating the dine-in COD OTP.
            //    Narrowest allowlist of any staff branch: cash managers
            //    never touch status, payment, or item/pricing fields.
            (isCashManagerUser() && request.resource.data.diff(resource.data).changedKeys().hasOnly([
              'cashManagerOtp',
              'cashManagerOtpGeneratedAt',
              'updatedAt'
            ])) ||

            // 2. Biller-page staff: full lifecycle + item/pricing control.
            //    Billers create and edit POS bills directly (AdminBiller.jsx
            //    lets a biller revise items/subtotal/total on an existing
            //    order before it's accepted), so this branch must include
            //    the pricing fields that the 'orders' branch below
            //    deliberately excludes.
            (canAccess('biller') && request.resource.data.diff(resource.data).changedKeys().hasOnly([
              'items',
              'subtotal',
              'totalAmount',
              'taxRate',
              'taxAmount',
              'customer',
              'orderType',
              'source',
              'status',
              'statusHistory',
              'payment',
              'revisionCount',
              'updatedAt',
              'cashManagerOtp',
              'cashManagerOtpFor',
              'cashManagerOtpGeneratedAt',
              'cashManagerOtpVerified',
              'cashManagerOtpVerifiedAt',
              'cashManagerOtpVerifiedBy',
              'verificationAttempts',
              'verificationLockedUntil',
              'deliveredAt',
              'mapUrl'
            ])) ||

            // 3. Orders-page staff (kitchen/front-of-house, no billing
            //    access): lifecycle and payment-collection fields only —
            //    deliberately EXCLUDES items/subtotal/totalAmount/customer/
            //    orderType/source. Orders-page staff verify OTPs, advance
            //    status (placed -> preparing -> ready -> delivered), and
            //    record COD cash collection, but must not be able to alter
            //    what was ordered or its price after the fact — that edit
            //    capability is reserved for the biller branch above, which
            //    is the only staff role that also owns bill creation.
            (canAccess('orders') && request.resource.data.diff(resource.data).changedKeys().hasOnly([
              'status',
              'statusHistory',
              'payment',
              'revisionCount',
              'updatedAt',
              'cashManagerOtp',
              'cashManagerOtpVerified',
              'cashManagerOtpVerifiedAt',
              'cashManagerOtpVerifiedBy',
              'verificationAttempts',
              'verificationLockedUntil',
              'deliveredAt'
            ]))
          )
        )
      );

      // DELETE: Only admins can delete orders.
      allow delete: if isAdmin();
    }

    // -----------------------------------------
    // MENU COLLECTION (Categories with Items)
    // -----------------------------------------
    match /menu/{categoryId} {
      allow read: if true; // Public - anyone can view menu
      allow create, update: if isAdmin() || canManageInventory();
      allow delete: if isAdmin();
    }

    // -----------------------------------------
    // LEGACY MENU COLLECTIONS
    // -----------------------------------------
    match /categories/{doc} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /menuItems/{doc} {
      allow read: if true;
      allow create, update: if isAdmin() || canManageInventory();
      allow delete: if isAdmin();
    }
    match /items/{doc} {
      allow read: if true;
      allow create, update: if isAdmin() || canManageInventory();
      allow delete: if isAdmin();
    }

    // -----------------------------------------
    // IMAGES COLLECTION (Menu Item Images)
    // -----------------------------------------
    match /images/{imageId} {
      allow read: if true; // Public - needed to display menu
      allow create, update: if isAdmin() || canManageInventory();
      allow delete: if isAdmin();
    }

    // -----------------------------------------
    // RAW MATERIALS / STOCK
    // -----------------------------------------
    match /raw_materials/{doc} {
      allow get: if isAdmin() || canManageInventory() || canAccess('biller');
      allow list: if isAdmin() || canManageInventory() || canAccess('biller');
      allow create, update: if isAdmin() || canManageInventory();
      allow delete: if isAdmin();
    }

    // DISABLED: OTP collection removed — OTPs now stored directly on order documents
    // match /otps/{otpId} {
    //   allow read: if isAdmin() || canAccess('biller') || canManageOrders();
    //   allow write: if isAdmin();
    // }

    // -----------------------------------------
    // MISCELLANEOUS CONFIG
    // -----------------------------------------
    // NOTE: miscellaneous/settings is intentionally public-read.
    // Do NOT store payment secrets or API keys in this document.
    //
    // Geofence/delivery-radius fields (minLat/maxLat/minLng/maxLng,
    // centerLat/centerLng/radiusKm) may still exist on this document for the
    // delivery-fee-by-distance calculation, but there is no longer a
    // rules-level geofence gate on order creation — that hard reject was
    // removed as part of the location policy change (delivery is now
    // coordinated by phone, not pinpoint GPS; see checkout/profile changes
    // in the same release). Order creation itself is server-owned (see
    // /orders above) and does not consult this document for a pass/fail
    // gate at all.
    match /miscellaneous/{docId} {
      // Public read - needed for app settings, appearance, store status
      allow read: if true;

      // Write permissions vary by document
      allow create, update: if (
        // Settings - admin only (includes delivery-fee config)
        (docId == 'settings' && isAdmin()) ||
        // Store status - admin only
        (docId == 'store' && isAdmin()) ||
        // Appearance - admin or staff with appearance access
        (docId == 'appearance' && canAccess('appearance')) ||
        // Daily counter - admin only. Order creation (and therefore the
        // counter transaction) now happens exclusively server-side via
        // /api/place-order (Admin SDK, bypasses these rules); no client
        // path increments this document anymore. Kept admin-writable only
        // for manual correction if the counter ever needs a manual reset.
        (docId == 'dailyCounter' && isAdmin())
      );
      allow delete: if isAdmin();
    }
    // -----------------------------------------
    // AUDIT LOGS
    // -----------------------------------------
    match /logs/{logId} {
      // Any staff member or super admin can create audit logs
      allow create: if isStaff() || isSuperAdmin();
      // Only super admin can read/update/delete logs
      allow read, update, delete: if isSuperAdmin();
    }

    // -----------------------------------------
    // HEALTH CHECK (Testing) - Read-only public
    // -----------------------------------------
    match /_health/{doc} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // -----------------------------------------
    // FCM TOKENS (Push notification tokens)
    // -----------------------------------------
    match /fcmTokens/{uid} {
      // Admins can read all FCM tokens (for sending pushes)
      allow read: if isAdmin() || isSuperAdmin();
      // Each signed-in user can only write their own token doc
      allow write: if isSignedIn() && request.auth.uid == uid;
    }

    // NOTE: `adminUsers/{uid}` has no match block — the collection is
    // retired (see header comment) and now falls through to Firestore's
    // implicit default-deny for any path with no matching rule.
  }
}
